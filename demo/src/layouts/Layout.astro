---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '@dennismiranda/astro-cart/styles.css';

  :root {
    /* personalización de colores del carrito */
    --cart-primary: #7c2d12;
    --cart-secondary: #1c1917;
    --cart-accent: #f59e0b;
    --cart-tertiary: #ea580c;
  }

  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: #fafaf9;
    color: #1c1917;
  }

  .page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 6rem;
  }

  .page h1 {
    margin-top: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }
</style>
