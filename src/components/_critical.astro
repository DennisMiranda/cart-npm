---
/**
 * Reglas críticas mínimas: ocultan drawer/backdrop/selector aunque el
 * consumidor no haya importado styles.css (evita un flash de contenido sin estilo).
 */
---

<style is:global>
  [data-cart-backdrop] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s;
  }

  [data-cart-backdrop][data-open='true'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  [data-cart-drawer] {
    visibility: hidden;
    transform: translateX(100%);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.45s;
  }

  [data-cart-drawer][data-open='true'] {
    visibility: visible;
    transform: translateX(0);
  }

  /*
   * El selector usa visibility (sin transform) para no pisar las reglas de
   * layout de styles.css (bottom-sheet en móvil / modal centrado en desktop).
   */
  [data-cart-selector] .ac-vs__backdrop,
  [data-cart-selector] .ac-vs__sheet {
    visibility: hidden;
  }

  [data-cart-selector][data-open='true'] .ac-vs__backdrop,
  [data-cart-selector][data-open='true'] .ac-vs__sheet {
    visibility: visible;
  }
</style>
