{
  "name": "@dennismiranda/astro-cart",
  "version": "0.1.0",
  "description": "Carrito de ecommerce funcional para Astro: drawer lateral, trigger flotante, variantes, persistencia y theming por CSS variables.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "**/*.astro"
  ],
  "keywords": [
    "astro",
    "astro-component",
    "cart",
    "ecommerce",
    "shopping-cart",
    "carrito"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DennisMiranda/cart-npm.git"
  },
  "homepage": "https://github.com/DennisMiranda/cart-npm#readme",
  "bugs": {
    "url": "https://github.com/DennisMiranda/cart-npm/issues"
  },
  "files": [
    "dist",
    "src/components",
    "src/core",
    "src/styles",
    "MANUAL.md",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./components": {
      "default": "./src/components/index.ts"
    },
    "./components/*": {
      "default": "./src/components/*.astro"
    },
    "./styles.css": "./src/styles/cart.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "lint": "publint --strict",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "lucide-astro": "^0.556.0"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "astro": "^7.3.8",
    "publint": "^0.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
